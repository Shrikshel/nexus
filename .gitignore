# ==========================================
# Nexus Host Management Agent - .gitignore
# ==========================================

# Compiled Class files
*.class

# Maven build outputs
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Log files & directories
logs/
*.log
hs_err_pid*
replay_pid*

# Nexus Agent Runtime files & IPC tokens
nexus.token
nexus.pid
.nexus/

# GraalVM Native Image Artifacts
*.build_artifacts.txt
target/nexus
target/nexus.exe

# ------------------------------------------
# IntelliJ IDEA
# ------------------------------------------
# User-specific & local workspace state (must not be committed)
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/dictionaries
.idea/**/shelf
.idea/**/contentModel.xml

# Local data sources and caches
.idea/**/dataSources/
.idea/**/dataSources.ids
.idea/**/dataSources.local.xml
.idea/**/sqlDataSources.xml
.idea/**/dynamic.xml
.idea/**/uiDesigner.xml
.idea/**/dbnavigator.xml
.idea/**/httpRequests

# Legacy file-based project artifacts
*.iws
*.iml
*.ipr
out/

# Explicitly KEEP shared project-level IntelliJ run configurations
!.run/
!.run/*.run.xml

# Explicitly KEEP common shared project settings if .idea is tracked
!.idea/
!.idea/compiler.xml
!.idea/encodings.xml
!.idea/jarRepositories.xml
!.idea/misc.xml
!.idea/vcs.xml
!.idea/inspectionProfiles/

# ------------------------------------------
# Visual Studio Code
# ------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ------------------------------------------
# Eclipse
# ------------------------------------------
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans

# ------------------------------------------
# OS generated files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*~
*.swp
*.swo

config.yaml
config.yml
